# DailyLumen - 每日复盘分析工具

# 项目本地记忆 (敏感/本地状态, 不入库)
#   例外：skills/ 是可复用的方法资产，跟代码一起版本化、打 tag
#   ⚠️ 必须用 `.workbuddy/*` 而不是 `.workbuddy/` —— 后者会连同目录一起排除，
#      导致 git 不再向下遍历，白名单 `!` 规则失效
.workbuddy/*
!.workbuddy/skills/
!.workbuddy/skills/**

# Python 缓存
__pycache__/
*.pyc

# 个人每日复盘数据（私人记录，不入库；仓库仅提供空的 reviews.example.db 作为 schema 模板）
review_tool/reviews.db

# 导出的数据文件（含个人数据，由 python -m review_tool export 生成）
exports/
