# CI / 开源 runner 个人参数夹具（非密钥）
#
# M47 起 PROFILE / BODY 真值只在本机 local/.env；GitHub Actions 无该文件，
# 若干测试仍按迁出前的公开基线断言（宏量 / 训练日离线兜底 / 饮食分中心）。
# 本文件仅供 CI 与「假装自己是 CI」演练；⛔ 不含 API Key / list ID / Web Key。
#
# 加载方式：
#   - .github/workflows/ci.yml 的 job env（子进程也能看见）
#   - tests/__init__.py 在 GITHUB_ACTIONS=true 时 setdefault 补齐

PROFILE_HEIGHT_CM=170
PROFILE_CARBS_G=220
PROFILE_PROTEIN_G=82
PROFILE_FAT_G=46
PROFILE_TRAINING_WEEKDAYS=0,1,2,4,5
BODY_WEIGHT_KG_LOW=64.0
BODY_WEIGHT_KG_HIGH=66.0
