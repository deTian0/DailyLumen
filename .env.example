# DailyLumen 环境变量模板 —— 复制为 .env 后填写（.env 不入 git）
#
# 设计口径（见 docs/生活管家路线图.md M16）：
#   .env 只放「凭据 + 环境差异」；个人参数（身高/目标/训练日）仍留 config.PROFILE，
#   业务规则（评分阈值/食物库）留代码 —— 后两者要随 git 走，否则换机即丢、破可重建性。

# ---------------------------------------------------------------------------
# 练练健身（KeepStrong）—— 运动主数据源
# ---------------------------------------------------------------------------
# 获取方式：练练健身 App > 我的 > 连接 AI > 生成 API Key > 复制 AI 连接信息
# ⚠️ 此值等同密码：只写在本文件，永不入 git、不贴进对话、不写进日志
KEEPSTRONG_API_KEY=

# 以下均有内置默认值，通常无需配置（列出来是为了「知道能改」）
# KEEPSTRONG_BASE_URL=https://lianlian.gzyunke.cn
# KEEPSTRONG_SKILL_VERSION=1.28.0
# KEEPSTRONG_AGENT_NAME=WorkBuddy
# KEEPSTRONG_TIMEOUT_S=30
# KEEPSTRONG_CACHE_DIR=.workbuddy/cache

# ---------------------------------------------------------------------------
# 路径覆盖（可选；默认按包目录自动推导）
# ---------------------------------------------------------------------------
# DAILYLUMEN_DB_PATH=
# DAILYLUMEN_HISTORY_SRC=

# ---------------------------------------------------------------------------
# ClickUp（可选）
# ---------------------------------------------------------------------------
# 凭据：这里优先；未配置时回落到 ~/.workbuddy/mcp.json（兼容旧路径）
# CLICKUP_API_KEY=
# CLICKUP_TEAM_ID=

# 端点与超时（v1.25.0 起纳入 Settings，与练练对称；以下有内置默认值，通常无需配置）
# CLICKUP_BASE_URL=https://api.clickup.com/api/v2
# CLICKUP_TIMEOUT_S=60
