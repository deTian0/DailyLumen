# DailyLumen 环境变量模板 —— 复制为 local/.env 后填写（local/.env 不入 git）
#
# 设计口径（M16 + M45–M47）：
#   local/.env 放「凭据 + 环境差异 + 个人参数 + ClickUp list ID」；
#   PERSONAL_ITEMS / HABITS / 评分规则留代码（D6=B / D7=B）。
#   根 .env.example 随仓库；⛔ 本文件无真值。

# ---------------------------------------------------------------------------
# 练练健身（KeepStrong）—— 运动主数据源
# ---------------------------------------------------------------------------
# 练练 AI API Key（Bearer）；等同密码，只写 local/.env
# 获取：练练健身 App > 我的 > 连接 AI > 生成 API Key > 复制 AI 连接信息
KEEPSTRONG_API_KEY=

# 以下均有内置默认值，通常无需配置（列出来是为了「知道能改」）
# 练练 API 根地址（默认 https://lianlian.gzyunke.cn）
# KEEPSTRONG_BASE_URL=https://lianlian.gzyunke.cn
# 请求头 X-KeepStrong-Skill-Version；与 docs/练练健身-API参考.md 对齐，426 时需更新
# KEEPSTRONG_SKILL_VERSION=1.28.0
# 请求头 X-KeepStrong-Agent-Name；稳定 ASCII 产品名，勿用模型名/用户名
# KEEPSTRONG_AGENT_NAME=WorkBuddy
# 练练 HTTP 超时（秒）；默认 30
# KEEPSTRONG_TIMEOUT_S=30
# 练练本地缓存目录（动作库等）；默认 .workbuddy/cache
# KEEPSTRONG_CACHE_DIR=.workbuddy/cache

# ---------------------------------------------------------------------------
# 路径覆盖（可选；默认按包目录自动推导 → local/...）
# ---------------------------------------------------------------------------
# SQLite 库路径；默认 local/reviews.db
# DAILYLUMEN_DB_PATH=
# 历史语雀源文件目录（import-history 用）；不内置个人路径，需自填
# DAILYLUMEN_HISTORY_SRC=

# ---------------------------------------------------------------------------
# ClickUp 凭据
# ---------------------------------------------------------------------------
# ClickUp Personal API Token
# 获取：ClickUp > Settings > Apps > API Token > Generate
# 读取顺序：进程环境变量 > local/.env > ~/.workbuddy/mcp.json（兼容回退）
# CLICKUP_API_KEY=
# ClickUp Team / Workspace ID（API 路径用）
# CLICKUP_TEAM_ID=

# 端点与超时（有内置默认值，通常无需配置）
# ClickUp REST API 根地址（默认 https://api.clickup.com/api/v2）
# CLICKUP_BASE_URL=https://api.clickup.com/api/v2
# ClickUp HTTP 超时（秒）；默认 60
# CLICKUP_TIMEOUT_S=60

# ---------------------------------------------------------------------------
# ClickUp list ID（M47 / D5=A）—— 填本机 workspace 的 list id，无真值模板
# ---------------------------------------------------------------------------
# 「日常事务」list：每日流水 + 学习/读书进度（默认日采）
CLICKUP_LIST_DAILY=
# 「习惯与打卡」list：长期习惯素材（→ habit_logs；与 personal_tracks 隔离）
CLICKUP_LIST_HABITS=
# 「工作」list：工时 / 工单记录（默认日采）
CLICKUP_LIST_WORK=
# 「项目孵化」list：想法 / 待孵化（默认不日采，按需 --list）
CLICKUP_LIST_INCUBATOR=
# 「年度目标」list：长期 Flag（默认不日采）
CLICKUP_LIST_ANNUAL=

# ---------------------------------------------------------------------------
# 个人参数（M47）—— 留空则 PROFILE/BODY 显示「未配置」/ 跳过检查
# ---------------------------------------------------------------------------
# 显示用昵称 / 称呼（进 PROFILE["name"]）
PROFILE_NAME=
# 身高（cm）；BMI 等体征计算用，留空=未配置
PROFILE_HEIGHT_CM=
# 日目标碳水（g）；饮食分宏量中心，留空=跳过宏量检查
PROFILE_CARBS_G=
# 日目标蛋白质（g）
PROFILE_PROTEIN_G=
# 日目标脂肪（g）
PROFILE_FAT_G=
# 训练日离线兜底：0=周一 … 6=周日，逗号分隔；主判据仍是练练 completed
PROFILE_TRAINING_WEEKDAYS=
# 早餐参考时间窗（HH:MM-HH:MM）；进 PROFILE["breakfast_window"]，默认 08:00-09:00
PROFILE_BREAKFAST_WINDOW=08:00-09:00

# 体征目标体重带下限（kg）；留空 = 未配置
BODY_WEIGHT_KG_LOW=
# 体征目标体重带上限（kg）；留空 = 未配置
BODY_WEIGHT_KG_HIGH=

# ---------------------------------------------------------------------------
# LLM 运行模式（L-1）—— 互斥，同时仅一种
# ---------------------------------------------------------------------------
# workbuddy（默认）= WorkBuddy/Cursor 宿主 Agent 代劳读图/写建议，落 md 后再 ingest；
#                   仓库进程内不调任何模型 API（也无 WorkBuddy SDK 可调）
# deepseek         = 仓库进程内调 DeepSeek API（可独立部署）；产出仍先落 md 再 ingest
# 空 / 未配 = workbuddy
DAILYLUMEN_LLM_MODE=workbuddy

# DeepSeek 凭据与端点 —— 仅 mode=deepseek 需要；真值只写 local/.env
# ⛔ 不要把真实 Key 写进本模板或任何入 git 的文件
DEEPSEEK_API_KEY=
# 官方 OpenAI 兼容根地址（默认 https://api.deepseek.com）；通常无需改
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat
# HTTP 超时（秒）；默认 60
# DEEPSEEK_TIMEOUT_S=60
